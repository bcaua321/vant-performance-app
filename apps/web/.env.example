# Banco de dados PostgreSQL
DATABASE_URL="postgresql://vant:vant@localhost:5432/vant?schema=public"

# Redis (filas BullMQ)
REDIS_URL="redis://localhost:6379"

# Microservico Python de calculo
PYTHON_ENGINE_URL="http://localhost:8000"

# Para o processo Next.js no host, configure o caminho absoluto para storage/graphs
GRAPHS_DIR="/storage/graphs"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
